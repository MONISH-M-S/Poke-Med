# Optional. If present, uploads are read by a vision model.
# Without it, PokéMed uses browser OCR (tesseract.js), sample text, or pasted text.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Optional. Local Donut prescription-OCR service (see services/ocr).
# When set, /api/scan asks it first; Vercel deployments can leave it empty.
OCR_SERVICE_URL=
# Optional. Must match the service's OCR_SHARED_SECRET when it has one.
OCR_SHARED_SECRET=

# Optional. If present, missed doses also send an email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com

# Session signing. Required in production: the app fails closed if it is missing.
# `npm run dev|build|start` generates a random one in .env.local locally.
AUTH_SECRET=

# Public origin used in pairing and doctor-report QR codes (tunnel or hostname).
# Leave empty locally to use the machine's LAN address.
NEXT_PUBLIC_APP_URL=

# Set to 1 only behind a proxy that overwrites x-forwarded-for (Vercel, nginx,
# Cloudflare). Otherwise the sign-in throttle ignores that spoofable header.
POKEMED_TRUST_PROXY=
