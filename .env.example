# Optional. If present, uploads are read by a vision model.
# Without it, PokéMed uses browser OCR (tesseract.js), sample text, or pasted text.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Signs the session cookie. Leave this empty: the first `npm run dev`, `build`
# or `start` generates a random secret in .env.local (git-ignored), so no
# published value can be used to forge a cookie. Set it yourself only when you
# deploy to a real host, or to force `POKEMED_REQUIRE_AUTH_SECRET=1`.
AUTH_SECRET=

# The sign-in throttle keys on the client address. x-forwarded-for is a header
# anyone can fake, so it is ignored unless this is 1 — set it only behind a
# proxy that overwrites the header (nginx, Vercel, Cloudflare).
POKEMED_TRUST_PROXY=

# Optional. If present, missed doses also send an email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@example.com
