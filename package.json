{
  "name": "pokemed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/ensure-secret.mjs && next dev -p 3000",
    "build": "node scripts/ensure-secret.mjs && next build",
    "start": "node scripts/ensure-secret.mjs && next start -p 3000",
    "seed": "tsx scripts/seed.ts",
    "test": "tsx scripts/selftest.ts",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-drug-index.mjs",
    "data:all": "npm run data:fetch && npm run data:build",
    "sample:make": "node scripts/make-sample.mjs",
    "test:ocr-service": "node scripts/ocr-service-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:security": "node scripts/security-test.mjs",
    "test:all": "npm test && npm run test:security && npm run test:ocr-service && npm run test:ui",
    "shots": "node scripts/shots.mjs",
    "ocr:bench": "node scripts/ocr-bench.mjs",
    "ocr:lab": "node scripts/ocr-lab.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "next": "15.5.28",
    "qrcode": "^1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
